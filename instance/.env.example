# Ethereum RPC endpoint.
# For local development use http://localhost:8545 (Foundry's anvil node).
# For production point at a Base mainnet RPC.
RPC_URL=http://localhost:8545

# Which chain to connect to: "anvil" for local dev, "base" for production.
CHAIN=anvil

# DEN contract addresses — fill these in after deploying the contracts.
# Run `forge script` against your target network to get these addresses.
IDENTITY_REGISTRY_ADDRESS=0x
SUBSCRIPTION_ADDRESS=0x
CONTENT_REGISTRY_ADDRESS=0x
ACCESS_GRANT_ADDRESS=0x
PURCHASE_STATE_ADDRESS=0x

# Path to the SQLite database file.
# Bun creates this file automatically on first run.
DB_PATH=./den-instance.db

# HTTP port the instance listens on.
PORT=3000
