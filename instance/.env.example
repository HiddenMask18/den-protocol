# Ethereum RPC endpoint.
# For local development use http://localhost:8545 (Foundry's anvil node).
# For production point at a Base mainnet RPC.
RPC_URL=http://localhost:8545

# Which chain to connect to: "anvil" for local dev, "base" for production.
CHAIN=anvil

# DEN contract addresses — fill these in after deploying the contracts.
# Run `forge script` against your target network to get these addresses.
IDENTITY_REGISTRY_ADDRESS=0x
SUBSCRIPTION_ADDRESS=0x
CONTENT_REGISTRY_ADDRESS=0x
ACCESS_GRANT_ADDRESS=0x
PURCHASE_STATE_ADDRESS=0x
COMPENSATION_ADDRESS=0x
REPORT_REGISTRY_ADDRESS=0x
TRUST_TIER_ADDRESS=0x
GOVERNANCE_ADDRESS=0x

# Path to the SQLite database file.
# Bun creates this file automatically on first run.
DB_PATH=./den-instance.db

# HTTP port the instance listens on.
PORT=3000

# Public base URL of this instance — the URL creators record on-chain as their home instance
# (DENIdentityImpl.updateInstanceURL). Required for GET /creator/url-signature; the instance
# only ever countersigns this URL. No trailing slash.
INSTANCE_PUBLIC_URL=

# Instance master key — 32-byte hex (64 chars). Every instance needs its own unique key.
# Generate: openssl rand -hex 32
# Back this up securely. Losing it means all creators must re-upload their master secret blobs.
# NEVER reuse this key across different instance deployments.
INSTANCE_MASTER_KEY=

# Instance operator private key — 0x-prefixed 32-byte hex (66 chars).
# This wallet must be registered as a DEN participant and set as the content operator for
# each hosted creator via DENContentRegistry.setContentOperator (spec §7.5).
# It signs claimCompensation transactions on the hoster's behalf (spec §7.2).
# Generate: openssl rand -hex 32 (then prepend 0x)
# Keep this secret. Back it up securely.
INSTANCE_OPERATOR_PRIVATE_KEY=
